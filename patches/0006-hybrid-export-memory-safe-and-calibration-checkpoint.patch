+++ b/examples/qualcomm/oss_scripts/llama/wrappers/encoding_checkpoint.py
@@ -0,0 +1,176 @@
+"""Checkpoint for the calibration result of a static LLM export (resume without re-calibrating).
+
+HybridTextDecoder._encoding_override copies quantization encodings from the calibrated graph to a fresh graph
+by walking both graphs in the same order. This module splits that walk in two: capture() records, in walk
+order, everything the override would copy (q/dq parameters, get_attr tensors, KV-cache encodings, plus each
+node's identity string for the same consistency checks), and apply() replays it onto a fresh graph. The
+record is saved with torch.save, so a crash after calibration costs minutes instead of a full re-calibration.
+"""
+from __future__ import annotations
+
+import os
+from typing import Any
+
+import torch
+from executorch.backends.qualcomm.builders.utils import is_graph_output
+
+class _Ops:
+    """q/dq op sets, looked up on first use (the torchao ops are registered by later imports)."""
+    _qdq = _ptq = None
+
+    @classmethod
+    def qdq(cls):
+        if cls._qdq is None:
+            cls._qdq = {
+                torch.ops.torchao.dequantize_affine,
+                torch.ops.torchao.quantize_affine,
+                torch.ops.quantized_decomposed.dequantize_per_channel.default,
+                torch.ops.quantized_decomposed.quantize_per_channel.default,
+            } | cls.ptq()
+        return cls._qdq
+
+    @classmethod
+    def ptq(cls):
+        if cls._ptq is None:
+            cls._ptq = {
+                torch.ops.quantized_decomposed.dequantize_per_tensor.default,
+                torch.ops.quantized_decomposed.quantize_per_tensor.default,
+            }
+        return cls._ptq
+
+
+_NODE = "__fx_node__"   # an argument that is a graph node: keep the target graph's own node at that position
+
+
+def _info(node) -> str:
+    return node.name + (str(node.meta["nn_module_stack"].values()) if node.op == "call_function" else "")
+
+
+def _resolve_param_target(node):
+    return node if node.op == "call_function" and node.target not in _Ops.qdq() else _resolve_param_target(list(node.users)[0])
+
+
+def _get_attr(gm, target: str) -> Any:
+    attr = gm
+    for atom in target.split("."):
+        attr = getattr(attr, atom)
+    return attr
+
+
+def _set_attr(gm, target: str, value: Any) -> None:
+    attr = gm
+    parts = target.split(".")
+    for atom in parts[:-1]:
+        attr = getattr(attr, atom)
+    setattr(attr, parts[-1], value)
+
+
+def _nodes(gm):
+    params = {n: _resolve_param_target(n) for n in gm.graph.nodes if n.op == "get_attr"}
+    acts = [n for n in gm.graph.nodes if n.target not in _Ops.qdq() and n.op in {"call_function", "placeholder"}]
+    return params, acts
+
+
+def _record_users(qnode) -> list:
+    out = []
+    for u in list(qnode.users):
+        if u.name == "output":
+            out.append(("skip",))
+        elif u.target in _Ops.qdq():
+            args = tuple(_NODE if isinstance(a, torch.fx.Node) else a for a in u.args[1:])
+            out.append(("qdq", str(u.target), args, _record_users(u)))
+        else:
+            out.append(("other", str(u.target)))
+    return out
+
+
+def _replay_users(rec: list, unode) -> None:
+    for item, u in zip(rec, list(unode.users)):
+        if item[0] == "skip":
+            continue
+        want = item[1]
+        assert str(u.target) == want, f"found unmatched targets: {want} vs {u.target}"
+        if item[0] == "qdq":
+            u.args = (u.args[0], *[u.args[i + 1] if a == _NODE else a for i, a in enumerate(item[2])])
+            _replay_users(item[3], u)
+
+
+def _kv_outputs(gm, is_node_src_start_with_name):
+    k, v = [], []
+    for node in gm.graph.nodes:
+        if not is_graph_output(node):
+            continue
+        cache = node.args[0].args[0]
+        if is_node_src_start_with_name(cache, kv_cache_prefix="k_"):
+            k.append(cache)
+        elif is_node_src_start_with_name(cache, kv_cache_prefix="v_"):
+            v.append(cache)
+    if not k or not v:
+        raise RuntimeError("KV cache detection failed while capturing encodings.")
+    return k, v
+
+
+def capture(quantized_model, is_node_src_start_with_name) -> dict:
+    params, acts = _nodes(quantized_model)
+    k_out, v_out = _kv_outputs(quantized_model, is_node_src_start_with_name)
+    return {
+        "version": 1,
+        "act_info": [_info(n) for n in acts],
+        "acts": [_record_users(n) for n in acts],
+        "param_info": [_info(t) for t in params.values()],
+        "params": [(_get_attr(quantized_model, p.target),
+                    _record_users(p) if list(p.users)[0].target in _Ops.ptq() else None) for p in params],
+        "kv_k": [_record_users(n) for n in k_out],
+        "kv_v": [_record_users(n) for n in v_out],
+    }
+
+
+def apply(rec: dict, unquantized_model, n_cache_layers: int) -> None:
+    """Replay a capture() record onto a fresh (converted, unencoded) graph. Same checks as _encoding_override."""
+    params, acts = _nodes(unquantized_model)
+    assert len(acts) == len(rec["acts"]) and len(params) == len(rec["params"]), "graph shape differs from checkpoint"
+    for want, node in zip(rec["act_info"], acts):
+        assert want == _info(node), f"found unmatched order for ops: {want} vs {_info(node)}"
+    for want, node in zip(rec["param_info"], params.values()):
+        assert want == _info(node), f"found unmatched order for ops: {want} vs {_info(node)}"
+    for users, node in zip(rec["acts"], acts):
+        _replay_users(users, node)
+    for (tensor, users), p in zip(rec["params"], params):
+        _set_attr(unquantized_model, p.target, tensor)
+        if users is not None:
+            _replay_users(users, p)
+    k_in, v_in = [], []
+    for node in unquantized_model.graph.nodes:
+        if node.op == "placeholder" and "args_" in node.name:
+            (v_in if int(node.name.split("_")[-1]) >= n_cache_layers else k_in).append(node)
+    if not k_in or not v_in:
+        raise RuntimeError("KV cache input detection failed while applying encodings.")
+    for users, node in zip(rec["kv_k"], k_in):
+        _replay_users(users, node)
+    for users, node in zip(rec["kv_v"], v_in):
+        _replay_users(users, node)
+    unquantized_model.recompile()
+
+
+def fingerprint(gm) -> list:
+    """Everything an encoding override can change: every q/dq node's non-node arguments and every get_attr
+    tensor (by identity). Two equal fingerprints mean two identical encodings."""
+    fp = []
+    for n in gm.graph.nodes:
+        if n.target in _Ops.qdq():
+            fp.append((n.name, tuple(a.tolist() if isinstance(a, torch.Tensor) else (None if isinstance(a, torch.fx.Node) else a)
+                                     for a in n.args[1:])))
+        elif n.op == "get_attr":
+            x = _get_attr(gm, n.target)
+            fp.append((n.target, id(x) if isinstance(x, torch.Tensor) else x))
+    return fp
+
+
+def save(rec: dict, path: str) -> None:
+    tmp = path + ".tmp"
+    torch.save(rec, tmp)
+    os.replace(tmp, path)          # atomic: a crash while saving never leaves a half-written checkpoint
+
+
+def load(path: str) -> dict:
+    return torch.load(path, weights_only=False)
