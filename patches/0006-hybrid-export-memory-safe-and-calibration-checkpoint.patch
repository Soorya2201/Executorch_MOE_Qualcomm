-        self.calibration_prefill.quantize(request)
+        # gc.collect() after every stage: export/prepare/convert leave the previous FX graph (with its own
+        # fp32 weights) behind in reference cycles, which only the cycle collector frees. Without it the
+        # stale copies pile up and a 4B model runs out of RAM + page file.
+        ckpt = f"{self.control_args.artifact}/calibration_encodings.pt"
+        verified = ckpt + ".verified"     # written only after the checkpoint reproduced the original override
+        if os.path.exists(ckpt) and os.path.exists(verified) and not self.apply_embedding:
+            # Resume: calibration already done in an earlier run; its encodings are on disk.
+            logging.info(f"Resuming from calibration checkpoint {ckpt}")
+            del self.calibration_prefill
+            gc.collect()
+            self.decode.quantize(request)
+            gc.collect()
+            rec = encoding_checkpoint.load(ckpt)
+            encoding_checkpoint.apply(rec, self.decode.decoder, self._n_cache_layers())
+            del rec
+            self._decode_meta_from_encodings()
+        else:
+            self.calibration_prefill.quantize(request)
+            gc.collect()
+            rec = encoding_checkpoint.capture(self.calibration_prefill.decoder, is_node_src_start_with_name)
+            encoding_checkpoint.save(rec, ckpt)
+            logging.info(f"Calibration checkpoint saved to {ckpt}")
+            self.decode.quantize(request)
+            gc.collect()
+            self._encodings_calibration_to_decode()
+            # Prove the checkpoint reproduces the original override exactly (so a resumed run is identical).
+            before = encoding_checkpoint.fingerprint(self.decode.decoder)
+            encoding_checkpoint.apply(rec, self.decode.decoder, self._n_cache_layers())
+            assert encoding_checkpoint.fingerprint(self.decode.decoder) == before,                 "calibration checkpoint does not reproduce the encoding override"
+            open(verified, "w").close()
+            logging.info("Calibration checkpoint verified against the original encoding override")
+            del rec, before
+            # The calibration model is not needed past this point: free it BEFORE building the prefill model.
+            del self.calibration_prefill
+        gc.collect()
+        self._build_prefill()
+        self.prefill.quantize(request)
+        gc.collect()
+        self._encodings_decode_to_prefill()
+        gc.collect()
+        self._encodings_done = True
 
